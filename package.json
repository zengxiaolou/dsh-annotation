{
  "name": "dsh-annotation",
  "version": "0.1.6",
  "type": "module",
  "description": "划选回答文字打注释，输入框内以胶囊聚合，多条一起随消息发送。",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./icon": "./icon.svg"
  },
  "files": [
    "lib",
    "icon.svg",
    "cordis.patch.yml",
    "README.md",
    "NOTICE",
    "LICENSE",
    "LICENSE-dsh-btw"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-layout"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-session": "0.2.0-rc.1 || 0.2.0-rc.2 || 0.2.1-rc.1 || 0.2.1-rc.2",
    "@deepseek-ai/dsh-system-prompt": "0.2.0-rc.1 || 0.2.0-rc.2 || 0.2.1-rc.1 || 0.2.1-rc.2"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/zengxiaolou/dsh-annotation"
  },
  "homepage": "https://github.com/zengxiaolou/dsh-annotation#readme",
  "bugs": {
    "url": "https://github.com/zengxiaolou/dsh-annotation/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness"
  ],
  "scripts": {
    "test": "node test/boot.test.mjs"
  },
  "devDependencies": {
    "react": "^18.3.1"
  }
}
